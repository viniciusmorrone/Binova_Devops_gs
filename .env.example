# Copie para .env (cp .env.example .env) e troque os valores. Nunca versione o .env.
POSTGRES_DB=binova
POSTGRES_USER=binova
POSTGRES_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE

# Chave do JWT em Base64 (minimo 32 bytes). Gere com: openssl rand -base64 48
JWT_SECRET_BASE64=TROQUE_PELA_SAIDA_DO_OPENSSL

# Senhas dos usuarios de demonstracao (admin@binova.local / cidadao@binova.local)
APP_DEMO_ADMIN_PASSWORD=AdminLocal2026
APP_DEMO_CIDADAO_PASSWORD=CidadaoLocal2026
